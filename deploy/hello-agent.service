[Unit]
Description=Hello Agent FastAPI Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/hello-agent
EnvironmentFile=/etc/hello-agent.env
ExecStart=/opt/hello-agent/.venv/bin/uvicorn hello_agent.api:app --host 127.0.0.1 --port 8000 --root-path /agent/api --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
