# 将真实密钥写入服务器的 /etc/hello-agent.env，不要提交到 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 多模型路由：便宜模型做分类/规划，强模型做写作/裁判；失败自动降级
# DEEPSEEK_MODEL_CHEAP=deepseek-v4-flash
# DEEPSEEK_MODEL_STRONG=deepseek-v4-pro
# DEEPSEEK_MODEL_FALLBACK=deepseek-v4-flash,deepseek-v4-pro
# 费用看板按每次响应的 usage Token × 单价估算，无法用 API Key 读取 DeepSeek 账户账单。
# 不填则使用官方公开价（USD / 1M tokens）：Flash 0.14 / 0.28，Pro 0.435 / 0.87。
DEEPSEEK_INPUT_PRICE_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=
DEEPSEEK_CACHE_HIT_PRICE_PER_MILLION=
# 可选：填写汇率后，看板上同时显示人民币约数。
DEEPSEEK_USD_TO_CNY=
TODO_DATABASE_FILE=/var/lib/hello-agent/agent.db
REDIS_URL=redis://127.0.0.1:6379/0
TASK_WORKER_NAME=hello-agent-worker
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_SCHEDULER_INTERVAL_SECONDS=60
DAILY_TODO_BRIEFING_TIMEZONE=Asia/Shanghai
KNOWLEDGE_DIR=/opt/hello-agent/knowledge
KNOWLEDGE_UPLOAD_DIR=/var/lib/hello-agent/knowledge_uploads
CHAT_ATTACHMENT_DIR=/var/lib/hello-agent/chat_attachments
OCR_ENABLED=true
OCR_LANG=chi_sim+eng
DEMO_KNOWLEDGE_DIR=/opt/hello-agent/demo_knowledge
SKILLS_DIR=/opt/hello-agent/skills
HELLO_AGENT_RELEASES_DIR=/var/lib/hello-agent/releases
FRONTEND_ORIGINS=http://106.13.175.227
AUTH_COOKIE_SECURE=false
ADMIN_COOKIE_SECURE=false
ADMIN_MFA_ENCRYPTION_KEY=
# 只有这些 Agent 账号会在功能中心看到“管理后台”入口（逗号分隔）。
# 后台实际登录仍必须使用独立管理员账号和双重认证。
AGENT_SUPER_ADMIN_EMAILS=
# 邮箱验证码功能的前置配置，未填写时管理端会显示“等待邮件服务”。
SMTP_HOST=
SMTP_FROM=
ADMIN_RECOVERY_EMAIL=
