# 复制这个文件为 .env 仅用于记录格式；本练习通过终端读取环境变量。
# 不要把真实 API Key 提交到 Git。
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 多模型路由：便宜模型做分类/规划拆解，强模型做写作与裁判；失败按 FALLBACK 链降级
# DEEPSEEK_MODEL_CHEAP=deepseek-v4-flash
# DEEPSEEK_MODEL_STRONG=deepseek-v4-pro
# DEEPSEEK_MODEL_FALLBACK=deepseek-v4-flash,deepseek-v4-pro
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_SCHEDULER_INTERVAL_SECONDS=60
DAILY_TODO_BRIEFING_TIMEZONE=Asia/Shanghai
# 可选：按 DeepSeek 当前价格填写每百万 Token 单价，用于运行面板估算费用。
# 两项使用相同货币单位；未配置时只展示 Token，不估算费用。
# DEEPSEEK_INPUT_PRICE_PER_MILLION=
# DEEPSEEK_OUTPUT_PRICE_PER_MILLION=
# 正式部署为 HTTPS 时设为 true。
AUTH_COOKIE_SECURE=false
# 后台管理员使用完全独立的账号和 Cookie。生产环境必须配置 Fernet 密钥：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ADMIN_MFA_ENCRYPTION_KEY=
# HTTPS 启用后改为 true。
ADMIN_COOKIE_SECURE=false
# 配置 SMTP_HOST 和 SMTP_FROM 后，安全设置页会显示邮箱验证可配置。
# SMTP_HOST=
# SMTP_FROM=
# 接收后台恢复验证码的邮箱；可以与发件邮箱相同。
# ADMIN_RECOVERY_EMAIL=
# 正式部署时填写允许访问 API 的前端域名，多个域名用逗号分隔。
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# 可选：自定义 Todo JSON 文件位置。
# TODO_FILE=/absolute/path/to/todos.json
# SQLite 数据库位置。默认是项目内的 data/agent.db。
# TODO_DATABASE_FILE=/absolute/path/to/agent.db
# 用户上传知识文档的保存目录。
# KNOWLEDGE_UPLOAD_DIR=/absolute/path/to/knowledge_uploads
